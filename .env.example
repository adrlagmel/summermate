# Copia este fichero como .env para cambiar la configuración local.
# .env está en .gitignore: nunca subas credenciales reales al repositorio.

# Usados por docker-compose.yml
DB_NAME=summermate
DB_PORT=5432

# Usados por docker-compose.yml y por la aplicación (application.yml)
DB_USER=summermate
DB_PASSWORD=summermate
DB_URL=jdbc:postgresql://localhost:5432/summermate

# Solo para "docker compose --profile app up": puerto de la aplicación y
# perfiles de Spring (dev carga los datos de ejemplo)
APP_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Fase 6 -------------------------------------------------------------------
# Avisos por correo (en Docker Compose van a Mailpit, http://localhost:8025)
# CORREO_ACTIVO=true
# MAIL_HOST=localhost
# MAIL_PORT=1025
# URL_BASE=http://localhost:8080
# Aviso legal
# LEGAL_TITULAR=Summermate
# LEGAL_CONTACTO=privacidad@example.com
